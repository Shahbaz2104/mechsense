# ------------------------------------------------------------------
# MechSense environment example.
# Copy to `.env` and adjust values. Never commit a real `.env` file.
# ------------------------------------------------------------------

# --- Backend ---
# PostgreSQL connection used by the API and Alembic.
# Local dev uses the PostgreSQL Unix socket (peer auth); Docker uses TCP with credentials.
DATABASE_URL=postgresql+psycopg://shahbaz@/mechsense?host=/var/run/postgresql
# Separate database for automated tests (created with `createdb mechsense_test`).
TEST_DATABASE_URL=postgresql+psycopg://shahbaz@/mechsense_test?host=/var/run/postgresql

# API host/port binding (FastAPI via uvicorn).
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated list of allowed CORS origins for the frontend dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Simulation / demo data ---
# Seed for the deterministic synthetic data generator.
SIMULATION_SEED=42
# Upper bound on readings created by a single /demo/generate call.
SIMULATION_MAX_BATCH=500

# --- CSV import limits ---
# Maximum accepted upload size in megabytes and row count per file.
IMPORT_MAX_FILE_MB=10
IMPORT_MAX_ROWS=100000

# --- Frontend ---
# Base URL of the backend API, consumed by the Vite app at build/runtime.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
